# Ports for the alternate-version workspace services in ../multi-php/compose.yml.
# They differ from the primary workspace ports so several versions can run side
# by side. Override any of them in your .env if they clash with something else.

# PHP 7.4 workspace
WORKSPACE_74_SSH_PORT=2224
WORKSPACE_74_BROWSERSYNC_HOST_PORT=3002
WORKSPACE_74_BROWSERSYNC_UI_HOST_PORT=3003
WORKSPACE_74_VUE_CLI_SERVE_HOST_PORT=8082
WORKSPACE_74_VUE_CLI_UI_HOST_PORT=8002
WORKSPACE_74_ANGULAR_CLI_SERVE_HOST_PORT=4202
WORKSPACE_74_VITE_PORT=5175

# PHP 5.6 workspace
WORKSPACE_56_SSH_PORT=2226
WORKSPACE_56_BROWSERSYNC_HOST_PORT=3004
WORKSPACE_56_BROWSERSYNC_UI_HOST_PORT=3005
WORKSPACE_56_VUE_CLI_SERVE_HOST_PORT=8084
WORKSPACE_56_VUE_CLI_UI_HOST_PORT=8004
WORKSPACE_56_ANGULAR_CLI_SERVE_HOST_PORT=4204
WORKSPACE_56_VITE_PORT=5177
