# changing the major version? see the DATA_PATH_HOST note above
POSTGRES_VERSION=17-alpine

# pg_search 全文搜索扩展版本（见 postgres/README.pg_search.md）
PG_SEARCH_VERSION=0.22.2

# 数据库数据目录（挂载在 DATA_PATH_HOST/postgres 下）
POSTGRES_TIMEZONE=Asia/Shanghai

# 共享内存大小，pg_search 等扩展需要较大 shm
POSTGRES_SHM_SIZE=1g

POSTGRES_ENTRYPOINT_INITDB=./postgres/docker-entrypoint-initdb.d

CONFLUENCE_POSTGRES_INIT=true

CONFLUENCE_POSTGRES_DB=laradock_confluence

CONFLUENCE_POSTGRES_USER=laradock_confluence

CONFLUENCE_POSTGRES_PASSWORD=laradock_confluence

GITLAB_POSTGRES_INIT=true

SONARQUBE_POSTGRES_INIT=true

KEYCLOAK_POSTGRES_INIT=true
